# Home Assistant REST API endpoint, trailing /api/ included
HOME_ASSISTANT_API_URL=http://homeassistant.local:8123/api/
# Long-lived access token (HA profile page -> Security -> Long-lived access tokens)
HOME_ASSISTANT_API_ACCESS_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated allow-list of chat ids. Empty means "answer anyone" -- test only.
TELEGRAM_CHAT_ID=

# Optional
#BOT_LANGUAGE=it
#HA_STT_ENTITY=stt.google_ai_stt
#STT_LANGUAGE_IT=it-IT
#STT_LANGUAGE_EN=en-US
# How often the script/automation catalogue is re-read, in seconds.
# It is read once at startup anyway; 0 disables the refresh cycle.
#RUNNABLES_REFRESH_SECONDS=300
